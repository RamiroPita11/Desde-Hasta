{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [{ "source": "/:path*", "destination": "/" }],
  "headers": [
    {
      "source": "/widget.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
